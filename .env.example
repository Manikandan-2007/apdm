# ==============================================================================
# APDM - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Replace 'YOUR_GEMINI_API_KEY_HERE' with your Google AI Studio API Key.
#    Get an API key at: https://aistudio.google.com/app/apikey
# 3. Run the app with:
#    flutter run --dart-define-from-file=.env
#    OR
#    flutter run --dart-define=GEMINI_API_KEY=your_actual_key_here
#
# NOTE: .env is ignored by .gitignore to prevent exposing secrets in version control.
# ==============================================================================

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=600
